rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    // ---- users: each user can read/create/update only their own profile ----
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'name', 'email', 'photoURL', 'createdAt'])
        && request.resource.data.uid == uid
        && request.resource.data.name is string && request.resource.data.name.size() <= 100
        && request.resource.data.email is string && request.resource.data.email == request.auth.token.email
        && request.resource.data.photoURL is string
        && request.resource.data.createdAt == request.time;
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.keys().hasOnly(['uid', 'name', 'email', 'photoURL', 'createdAt']);
      allow delete: if false;
    }

    // ---- jobs ----
    match /jobs/{jobId} {

      function validJob(d) {
        return d.keys().hasOnly(['jobId', 'userId', 'jobTitle', 'description', 'workPeriod', 'workDays', 'salary', 'wilaya', 'phoneNumber', 'createdAt'])
          && d.keys().hasAll(['jobId', 'userId', 'jobTitle', 'description', 'workPeriod', 'workDays', 'salary', 'wilaya', 'phoneNumber', 'createdAt'])
          && d.jobId == jobId
          && d.userId == request.auth.uid
          && d.jobTitle is string && d.jobTitle.size() >= 2 && d.jobTitle.size() <= 80
          && d.description is string && d.description.size() >= 20 && d.description.size() <= 2000
          && d.workPeriod in ['morning', 'evening', 'both']
          && d.workDays is list && d.workDays.size() >= 1 && d.workDays.size() <= 7
          && d.workDays.hasOnly(['daily', 'sat', 'sun', 'mon', 'tue', 'wed', 'thu', 'fri'])
          && d.salary is int && d.salary >= 1 && d.salary <= 100000000
          && d.wilaya in ['hodh-chargui', 'hodh-gharbi', 'assaba', 'gorgol', 'brakna', 'trarza', 'adrar',
                          'dakhlet-nouadhibou', 'tagant', 'guidimaka', 'tiris-zemmour', 'inchiri',
                          'nouakchott-nord', 'nouakchott-ouest', 'nouakchott-sud']
          && d.phoneNumber is string && d.phoneNumber.matches('^[234][0-9]{7}$')
          && d.createdAt == request.time;
      }

      allow read: if true;                                   // anyone can browse jobs
      allow create: if signedIn()
        && request.auth.token.email_verified == true         // only verified emails can post
        && validJob(request.resource.data);                  // owner = caller, data validated
      allow update: if false;                                // no edits (as specified)
      allow delete: if signedIn() && resource.data.userId == request.auth.uid; // owner only
    }

    match /{document=**} { allow read, write: if false; }
  }
}
