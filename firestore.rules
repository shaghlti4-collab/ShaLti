rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    // Developer accounts: a document admins/{uid} created manually in the Firebase console.
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;   // lets the dashboard check "am I admin?"
      allow write: if false;                                  // only via console
    }

    // ---- users: owner reads/creates/updates own profile; developer can read all ----
    match /users/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isAdmin();
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'name', 'email', 'photoURL', 'createdAt'])
        && request.resource.data.uid == uid
        && request.resource.data.name is string && request.resource.data.name.size() <= 100
        && request.resource.data.email is string && request.resource.data.email == request.auth.token.email
        && request.resource.data.photoURL is string
        && request.resource.data.createdAt == request.time;
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.keys().hasOnly(['uid', 'name', 'email', 'photoURL', 'createdAt']);
      allow delete: if false;
    }

    // ---- restrictions: only the developer writes; a user can read only their own ----
    match /restrictions/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['uid', 'reason', 'by', 'createdAt'])
        && request.resource.data.uid == uid
        && request.resource.data.by == request.auth.uid
        && request.resource.data.reason is string
        && request.resource.data.reason.size() >= 1 && request.resource.data.reason.size() <= 500;
      allow delete: if isAdmin();
    }

    // ---- jobs ----
    match /jobs/{jobId} {

      function validJob(d) {
        return d.keys().hasOnly(['jobId', 'userId', 'jobTitle', 'description', 'workPeriod', 'workDays', 'salary', 'wilaya', 'phoneNumber', 'createdAt', 'srcLang', 'tr'])
          && d.keys().hasAll(['jobId', 'userId', 'jobTitle', 'description', 'workPeriod', 'workDays', 'salary', 'wilaya', 'phoneNumber', 'createdAt', 'srcLang'])
          && d.jobId == jobId
          && d.userId == request.auth.uid
          && d.jobTitle is string && d.jobTitle.size() >= 2 && d.jobTitle.size() <= 80
          && d.description is string && d.description.size() >= 20 && d.description.size() <= 2000
          && d.workPeriod in ['morning', 'evening', 'both']
          && d.workDays is list && d.workDays.size() >= 1 && d.workDays.size() <= 7
          && d.workDays.hasOnly(['daily', 'sat', 'sun', 'mon', 'tue', 'wed', 'thu', 'fri'])
          && d.salary is int && d.salary >= 1 && d.salary <= 100000000
          && d.wilaya in ['hodh-chargui', 'hodh-gharbi', 'assaba', 'gorgol', 'brakna', 'trarza', 'adrar',
                          'dakhlet-nouadhibou', 'tagant', 'guidimaka', 'tiris-zemmour', 'inchiri',
                          'nouakchott-nord', 'nouakchott-ouest', 'nouakchott-sud']
          && d.phoneNumber is string && d.phoneNumber.matches('^[234][0-9]{7}$')
          && d.srcLang in ['ar', 'fr']
          && (!('tr' in d.keys()) || (d.tr is map
                && d.tr.keys().hasOnly(['jobTitle', 'description'])
                && d.tr.jobTitle is string && d.tr.jobTitle.size() <= 300
                && d.tr.description is string && d.tr.description.size() <= 6000))
          && d.createdAt == request.time;
      }

      allow read: if true;                                          // anyone can browse jobs
      allow create: if signedIn()
        && request.auth.token.email_verified == true                // verified emails only
        && !exists(/databases/$(database)/documents/restrictions/$(request.auth.uid))  // not restricted
        && validJob(request.resource.data);
      allow update: if false;                                       // no edits
      allow delete: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin()); // owner or developer
    }

    match /{document=**} { allow read, write: if false; }
  }
}
